{
  "name": "shopify-theme-lab",
  "version": "1.0.0",
  "description": "Liquid work on a Shopify development store: Liquid additions to a Dawn-based theme, a Claude-generated sale page converted to native sections, and a measured performance diagnosis.",
  "scripts": {
    "test": "node tests/countdown.test.cjs",
    "test:mutants": "node tests/countdown_mutants.cjs",
    "test:liquid": "node tests/liquid.test.cjs",
    "test:liquid-mutants": "node tests/liquid_mutants.cjs",
    "test:spec": "node tests/spec_table.test.cjs",
    "preview": "node tests/render/build_preview.cjs && node tests/render/shoot.cjs",
    "css": "sass styles/spec-table.scss assets/spec-table.css --style=compressed --no-source-map",
    "css:watch": "sass --watch styles/spec-table.scss assets/spec-table.css --no-source-map",
    "check": "shopify theme check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Exalt24/shopify-theme-lab.git"
  },
  "keywords": [],
  "author": "Daniel Alexis Cruz",
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Exalt24/shopify-theme-lab/issues"
  },
  "homepage": "https://github.com/Exalt24/shopify-theme-lab#readme",
  "dependencies": {
    "lighthouse": "^13.4.1"
  },
  "devDependencies": {
    "liquidjs": "^10.30.0",
    "playwright": "^1.50.0",
    "sass": "^1.103.1"
  }
}
