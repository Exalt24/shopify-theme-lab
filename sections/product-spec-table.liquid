{% comment %}
  Metafield-driven specification table.

  THE PROBLEM IT SOLVES. A technical catalogue lives or dies on specifications:
  purity, particle size, CAS number, dimensions, tolerance. Most stores paste that
  into the description as an HTML blob, which cannot be filtered, cannot be
  compared across products, cannot be exported, and cannot be marked up for search
  because it is prose. Moving it into metafields makes each spec a real field, and
  this section renders whatever fields exist without a code change per product.

  WHY A DEFINITION LIST AND NOT A TABLE. Semantically these are name/value pairs,
  not tabular data with row and column relationships, and `dl` is what a screen
  reader announces correctly. It also collapses to one column on a phone with no
  horizontal scroll, which a real `table` will not do without a wrapper.

  THE LIQUID DETAIL THAT MATTERS. `product.metafields.specs` is a namespace, and
  iterating it yields `[key, metafield]` pairs where the second item is a
  Metafield DROP, not a string. Rendering the drop directly works for most types
  and silently prints an object for others, so the value goes through the type
  check below. Getting this wrong is the single most common metafield bug: it
  looks right for text fields and prints garbage the day someone adds a dimension
  or a rating.

  Blank-safe by construction: the whole section renders nothing when the namespace
  is empty, so it can sit in the default product template for every product
  without leaving an empty heading on the ones that have no specs.
{% endcomment %}

{%- liquid
  assign ns = product.metafields[section.settings.namespace]
  assign shown = 0
-%}

{%- if ns != blank -%}
  <div class="spec-table" style="
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  ">
    <div class="spec-table__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="spec-table__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <dl class="spec-table__list">
        {%- for pair in ns -%}
          {%- liquid
            assign key = pair[0]
            assign field = pair[1]
          -%}
          {%- if field.value != blank -%}
            {%- assign shown = shown | plus: 1 -%}
            <div class="spec-table__row">
              {%- comment -%}
                The key is a machine handle such as particle_size. Turned into a
                label here rather than stored twice, so a new metafield needs no
                second entry anywhere to display properly.
              {%- endcomment -%}
              <dt class="spec-table__key">
                {{- key | replace: '_', ' ' | capitalize -}}
              </dt>
              <dd class="spec-table__value">
                {%- case field.type -%}
                  {%- when 'dimension' -%}
                    {{ field.value.value }}&nbsp;{{ field.value.unit }}
                  {%- when 'weight' -%}
                    {{ field.value.value }}&nbsp;{{ field.value.unit }}
                  {%- when 'volume' -%}
                    {{ field.value.value }}&nbsp;{{ field.value.unit }}
                  {%- when 'rating' -%}
                    {{ field.value.value }} / {{ field.value.scale_max }}
                  {%- when 'list.single_line_text_field' -%}
                    {{ field.value | join: ', ' }}
                  {%- when 'boolean' -%}
                    {% if field.value %}Yes{% else %}No{% endif %}
                  {%- when 'url' -%}
                    <a href="{{ field.value }}" rel="nofollow">{{ field.value }}</a>
                  {%- else -%}
                    {{ field.value }}
                {%- endcase -%}
              </dd>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </dl>

      {%- if section.settings.show_schema and shown > 0 -%}
        {%- comment -%}
          additionalProperty is the correct schema.org home for arbitrary specs,
          and it attaches to the Product node the theme already emits rather than
          declaring a second Product, which would be a duplicate entity and is a
          common way to lose a rich result.
        {%- endcomment -%}
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Product",
          "@id": {{ request.origin | append: product.url | append: '#product' | json }},
          "additionalProperty": [
            {%- assign first = true -%}
            {%- for pair in ns -%}
              {%- if pair[1].value != blank -%}
                {%- unless first %},{% endunless -%}
                {
                  "@type": "PropertyValue",
                  "name": {{ pair[0] | replace: '_', ' ' | capitalize | json }},
                  "value": {{ pair[1].value | json }}
                }
                {%- assign first = false -%}
              {%- endif -%}
            {%- endfor -%}
          ]
        }
        </script>
      {%- endif -%}
    </div>
  </div>

  {%- style -%}
    .spec-table__inner {
      max-width: var(--page-width, 1200px);
      margin: 0 auto;
      padding: 0 1.5rem;
    }
    .spec-table__heading {
      font-size: 1.25rem;
      margin: 0 0 1rem;
    }
    .spec-table__list {
      margin: 0;
      border-top: 1px solid rgba(128, 128, 128, 0.25);
    }
    .spec-table__row {
      display: grid;
      /* Two columns on a real screen, stacked on a phone. minmax with a floor
         stops a long spec name from squeezing the value into one character per
         line, which is what a plain 1fr 1fr does at 390px. */
      grid-template-columns: minmax(9rem, 30%) 1fr;
      gap: 0.75rem;
      padding: 0.6rem 0;
      border-bottom: 1px solid rgba(128, 128, 128, 0.25);
    }
    @media screen and (max-width: 480px) {
      .spec-table__row { grid-template-columns: 1fr; gap: 0.15rem; }
    }
    .spec-table__key { font-weight: 600; margin: 0; }
    .spec-table__value { margin: 0; }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "Specification table",
  "tag": "section",
  "class": "section-spec-table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Specifications"
    },
    {
      "type": "text",
      "id": "namespace",
      "label": "Metafield namespace",
      "default": "specs",
      "info": "Every metafield in this namespace is rendered, in the order Shopify returns them. Adding a spec needs no theme change."
    },
    {
      "type": "checkbox",
      "id": "show_schema",
      "label": "Emit specs as structured data",
      "default": true,
      "info": "Adds additionalProperty to the existing Product schema. Turn off if another app already emits it, so the page does not declare the product twice."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Specification table"
    }
  ]
}
{% endschema %}
