{{ 'section-bundle-contents.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bundle = section.settings.bundle_product
  if bundle == blank
    assign bundle = product
  endif
  assign items = bundle.metafields.custom.bundle_items.value
  assign bundle_variant = bundle.selected_or_first_available_variant
  assign separate_total = 0
  assign parts_available = true
  for item in items
    assign separate_total = separate_total | plus: item.selected_or_first_available_variant.price
    unless item.available
      assign parts_available = false
    endunless
  endfor
  assign can_buy = false
  if bundle_variant.available and parts_available
    assign can_buy = true
  endif
  assign saving = separate_total | minus: bundle_variant.price
  assign percent_text = ''
  if separate_total > 0 and saving > 0
    assign percent = saving | times: 100.0 | divided_by: separate_total | round: 1
    assign percent_text = percent | append: '' | replace: '.0', ''
  endif
  assign saving_money = saving | money
  assign heading = section.settings.heading | default: bundle.title
-%}

{%- style -%}
  #BundleContents-{{ section.id }} {
    --bundle-pad-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --bundle-pad-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #BundleContents-{{ section.id }} {
      --bundle-pad-top: {{ section.settings.padding_top }}px;
      --bundle-pad-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if bundle != blank and items != blank -%}
  <div id="BundleContents-{{ section.id }}" class="bundle-contents">
    <div class="page-width">
      <div class="bundle-contents__card color-{{ section.settings.color_scheme }} gradient">
        <h2 class="bundle-contents__heading">{{ heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="bundle-contents__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}

        <p class="visually-hidden">{{ 'sections.bundle_contents.includes' | t }}</p>
        <ul class="bundle-contents__items">
          {%- for item in items -%}
            <li class="bundle-contents__item">
              <a href="{{ item.url }}" class="bundle-contents__link">
                <div class="bundle-contents__media">
                  {%- if item.featured_media != blank -%}
                    {{
                      item.featured_media.preview_image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        widths: '165, 360, 535, 800',
                        sizes: '(min-width: 750px) 33vw, 50vw',
                        alt: item.featured_media.alt
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <span class="bundle-contents__name">{{ item.title | escape }}</span>
              </a>
              <span class="bundle-contents__price">{{ item.selected_or_first_available_variant.price | money }}</span>
            </li>
          {%- endfor -%}
        </ul>

        <dl class="bundle-contents__totals">
          {%- if saving > 0 -%}
            <div class="bundle-contents__row">
              <dt>{{ 'sections.bundle_contents.separately' | t }}</dt>
              <dd><s>{{ separate_total | money }}</s></dd>
            </div>
          {%- endif -%}
          <div class="bundle-contents__row bundle-contents__row--price">
            <dt>{{ 'sections.bundle_contents.bundle_price' | t }}</dt>
            <dd>{{ bundle_variant.price | money }}</dd>
          </div>
          {%- if saving > 0 and section.settings.show_savings -%}
            <div class="bundle-contents__row bundle-contents__row--save">
              <dt class="visually-hidden">{{ 'sections.bundle_contents.save_label' | t }}</dt>
              <dd>{{ 'sections.bundle_contents.you_save' | t: amount: saving_money, percent: percent_text }}</dd>
            </div>
          {%- endif -%}
        </dl>

        {%- if section.settings.show_add_to_cart -%}
          {%- form 'product', bundle, id: section.id, class: 'bundle-contents__form' -%}
            <input type="hidden" name="id" value="{{ bundle_variant.id }}">
            <button
              type="submit"
              name="add"
              class="button bundle-contents__button"
              {% unless can_buy %}
                disabled
              {% endunless %}
            >
              {%- if can_buy -%}
                {{ 'sections.bundle_contents.add_to_cart' | t }}
              {%- else -%}
                {{ 'sections.bundle_contents.sold_out' | t }}
              {%- endif -%}
            </button>
          {%- endform -%}
        {%- endif -%}
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width">
    <p class="bundle-contents__hint">{{ 'sections.bundle_contents.empty_hint' | t }}</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bundle contents",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Bundle product",
      "info": "Leave empty on a product page to use that product. Its \"bundle_items\" metafield (a list of products, each counted once) is what gets listed, so create that metafield first (scripts/seed_sale_demo.py does it for the dev store). Use a bundle product with a single variant; the first available variant is the one priced and added. The button is disabled while any listed product is sold out."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "accent-1", "label": "t:sections.all.colors.accent_1.label" },
        { "value": "accent-2", "label": "t:sections.all.colors.accent_2.label" },
        { "value": "background-1", "label": "t:sections.all.colors.background_1.label" },
        { "value": "background-2", "label": "t:sections.all.colors.background_2.label" },
        { "value": "inverse", "label": "t:sections.all.colors.inverse.label" }
      ],
      "default": "background-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the bundle product's title."
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "Everything in one box, at one price.",
      "label": "Text under the heading"
    },
    {
      "type": "checkbox",
      "id": "show_savings",
      "default": true,
      "label": "Show the saving",
      "info": "Worked out from the list prices of the parts. It only appears when the bundle costs less than the parts, and it does not know about an automatic discount, so keep the parts out of any discounted collection."
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "default": false,
      "label": "Show an add to cart button",
      "info": "Turn on for landing pages. On a product page the normal buy button is already there."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Bundle contents"
    }
  ]
}
{% endschema %}
